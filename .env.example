# Example only. Set real values in your own environment; never commit secrets.
ECLIPSE_MODEL_PATH=/absolute/path/to/your-trained-eclipse-checkpoint
ECLIPSE_API_TOKEN=replace-with-a-long-random-secret
ECLIPSE_HOST=127.0.0.1
ECLIPSE_PORT=8765

# Optional scoped local memory: configure all three together.
# ECLIPSE_MEMORY_DB_PATH=/private/path/to/eclipse-memory.sqlite3
# ECLIPSE_EMBEDDING_MODEL_PATH=/absolute/path/to/local-embedding-model
# ECLIPSE_MEMORY_SCOPE_ID=single-operator

# Optional tools are disabled unless explicitly enabled (0 or 1).
# ECLIPSE_ENABLE_WEB_RESEARCH=0
# ECLIPSE_ENABLE_SANDBOX_EXECUTION=0
# External isolated sandbox configuration is needed if execution is enabled.
# ECLIPSE_SANDBOX_URL=https://your-isolated-sandbox.example
# ECLIPSE_SANDBOX_TOKEN=replace-with-a-separate-secret