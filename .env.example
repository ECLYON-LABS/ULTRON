# Example only. Set real values in your own environment; never commit secrets.
ULTRON_MODEL_PATH=/absolute/path/to/your-trained-ultron-checkpoint
ULTRON_API_TOKEN=replace-with-a-long-random-secret
ULTRON_HOST=127.0.0.1
ULTRON_PORT=8765

# Optional scoped local memory: configure all three together.
# ULTRON_MEMORY_DB_PATH=/private/path/to/ultron-memory.sqlite3
# ULTRON_EMBEDDING_MODEL_PATH=/absolute/path/to/local-embedding-model
# ULTRON_MEMORY_SCOPE_ID=single-operator

# Optional tools are disabled unless explicitly enabled (0 or 1).
# ULTRON_ENABLE_WEB_RESEARCH=0
# ULTRON_ENABLE_SANDBOX_EXECUTION=0
# External isolated sandbox configuration is needed if execution is enabled.
# ULTRON_SANDBOX_URL=https://your-isolated-sandbox.example
# ULTRON_SANDBOX_TOKEN=replace-with-a-separate-secret

# Optional read-only SQL tool; use a dedicated least-privilege database account.
# ULTRON_READONLY_DATABASE_URL=postgresql://user:password@host/database