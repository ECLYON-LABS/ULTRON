# Example only. Set real values in your own environment; never commit secrets.
PLUTO_MODEL_PATH=/absolute/path/to/your-trained-pluto-checkpoint
PLUTO_API_TOKEN=replace-with-a-long-random-secret
PLUTO_HOST=127.0.0.1
PLUTO_PORT=8765

# Optional scoped local memory: configure all three together.
# PLUTO_MEMORY_DB_PATH=/private/path/to/pluto-memory.sqlite3
# PLUTO_EMBEDDING_MODEL_PATH=/absolute/path/to/local-embedding-model
# PLUTO_MEMORY_SCOPE_ID=single-operator

# Optional tools are disabled unless explicitly enabled (0 or 1).
# PLUTO_ENABLE_WEB_RESEARCH=0
# PLUTO_ENABLE_SANDBOX_EXECUTION=0
# External isolated sandbox configuration is needed if execution is enabled.
# PLUTO_SANDBOX_URL=https://your-isolated-sandbox.example
# PLUTO_SANDBOX_TOKEN=replace-with-a-separate-secret

# Optional read-only SQL tool; use a dedicated least-privilege database account.
# PLUTO_READONLY_DATABASE_URL=postgresql://user:password@host/database